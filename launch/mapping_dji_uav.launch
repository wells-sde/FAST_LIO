<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_lio)/config/mid360_dji_uav.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.4" />
	<param name="filter_size_map" type="double" value="0.4" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
	<param name="save_dir" type="string" value="$(find fast_lio)" />

	<param name="log_level" type="string" value="info"/> <!-- 可选: debug, info, warn, error -->
	<env name="ROSCONSOLE_FORMAT" value="[${severity}] [${time:%Y-%m-%d %H:%M:%S.%f}] [${node}]: ${message}"/>

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

    <!-- <node pkg="fast_lio" type="gnss_to_odom.py" name="gnss_to_odom" output="screen" /> -->

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/lio_map.rviz" />
	</group>

</launch>
