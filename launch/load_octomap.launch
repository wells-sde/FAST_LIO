<launch>
    <!-- 设置需要加载的 .ot 文件路径 -->
    <arg name="map_file" default="/home/airs/sim_single_box.ot" />
    <arg name="frame_id" default="map" />

    <!-- 启动 octomap_server 节点 -->
    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
        <param name="map_file" value="$(arg map_file)" />
        <param name="frame_id" value="$(arg frame_id)" />
        <param name="latch" value="true" />
        <param name="occupancy_max_z" value="0.3"/>
        <param name="occupancy_min_z" value="-1.0"/> <!-- for G1,利用高度过滤地面点云 -->
        <remap from="projected_map" to="/map" />    <!-- 发布的栅格地图话题 -->
    </node>
</launch>